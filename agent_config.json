          "tags": ["语音", "说话"],
          "examples": ["买第一个两双"]
        },
        {
          "id": "admin-dashboard",
          "name": "管理员查询",
          "description": "查询平台用户统计和订单总数",
          "tags": ["管理", "统计"],
          "examples": ["查看所有用户"]
        },
        {
          "id": "customer-service",
          "name": "客服工单",
          "description": "查询和处理购物咨询工单",
          "tags": ["客服", "工单"],
          "examples": ["查看待处理工单"]
        }
