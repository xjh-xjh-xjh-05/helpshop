{
  "agentCards": [
    {
      "agentId": "helpshop-shopping-agent",
      "name": "HelpShop银发购物助手",
      "description": "面向老人的语音购物助手，支持商品搜索、多平台比价、下单确认、支付全流程，并支持子女协助购物和管理后台管理",
      "version": "1.0.0",
      "category": "shopping",
