          "tags": ["购物", "比价", "推荐"],
          "examples": ["我想买一双不累脚的鞋", "帮我看看家用血压计"]
        },
        {
          "id": "product-search",
          "name": "商品搜索",
          "description": "在商品库中搜索符合关键词的商品列表",
          "tags": ["搜索", "商品"],
          "examples": ["搜一下老年手机"]
        },
        {
          "id": "order-confirm",
          "name": "下单确认",
